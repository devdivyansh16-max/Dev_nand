CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=instruction[5], out=loadCToA);
    Or(a=isAInstruction, b=loadCToA, out=loadA);
    And(a=instruction[15], b=instruction[4], out=loadD);
    And(a=instruction[15], b=instruction[3], out=writeM);

    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);
    ARegister(in=aInput, load=loadA, out=aRegister);
    DRegister(in=aluOut, load=loadD, out=dRegister);

    Mux16(a=aRegister, b=inM, sel=instruction[12], out=aluY);
    ALU(
        x=dRegister, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, zr=isZero, ng=isNegative
    );

    Not(in=isZero, out=notZero);
    Not(in=isNegative, out=notNegative);
    And(a=notZero, b=notNegative, out=isPositive);
    And(a=instruction[0], b=isPositive, out=jumpGreater);
    And(a=instruction[1], b=isZero, out=jumpEqual);
    And(a=instruction[2], b=isNegative, out=jumpLess);
    Or(a=jumpGreater, b=jumpEqual, out=jumpGreaterOrEqual);
    Or(a=jumpGreaterOrEqual, b=jumpLess, out=jumpCondition);
    And(a=instruction[15], b=jumpCondition, out=jump);

    PC(in=aRegister, load=jump, inc=true, reset=reset, out[0..14]=pc);

    Or16(a=false, b=aluOut, out=outM);
    Or16(a=false, b=aRegister, out[0..14]=addressM);
}
