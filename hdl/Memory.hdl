CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=selectRAM);
    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=selectScreen);
    And(a=address[14], b=address[13], out=selectKeyboard);

    And(a=load, b=selectRAM, out=loadRAM);
    And(a=load, b=selectScreen, out=loadScreen);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    Mux16(a=ramOut, b=screenOut, sel=address[14], out=ramOrScreen);
    Mux16(a=ramOrScreen, b=keyboardOut, sel=selectKeyboard, out=out);
}
